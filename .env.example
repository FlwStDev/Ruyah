# ---------------------------------------------------------------------------
# PostForge environment. Copy to .env and fill in.
#   cp .env.example .env
# Generate the two secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------

DATABASE_URL="file:./dev.db"

APP_URL=http://localhost:3000

# Public HTTPS origin (ngrok / cloudflared). Required for Instagram publishing
# and for Reddit native media, because those APIs fetch your media themselves
# and cannot reach localhost. Leave blank for X-only / text-only testing.
PUBLIC_BASE_URL=

# Set to false once your account exists to close registration.
ALLOW_REGISTER=true

# 32+ byte hex. Encrypts OAuth tokens at rest (AES-256-GCM).
# Changing this makes every stored token unreadable -> reconnect accounts.
TOKEN_ENCRYPTION_KEY=

# 32+ character secret for the iron-session login cookie.
SESSION_SECRET=

# --- X (Twitter) --- https://console.x.com -> Projects & Apps -> User auth settings
# Type of App: Web App / Automated App. App permissions: Read and write.
X_CLIENT_ID=
X_CLIENT_SECRET=
# X's settings form rejects localhost / 127.0.0.1 / most http hosts.
# Run `pnpm tunnel` and paste the https://….trycloudflare.com callback it prints.
X_REDIRECT_URI=

# --- Reddit --- https://www.reddit.com/prefs/apps -> create app -> type "web app"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3000/api/oauth/reddit/callback
# Reddit rejects generic user agents. Put your real username in here.
REDDIT_USER_AGENT=web:postforge:0.1.0 (by /u/replace)

# --- Instagram --- https://developers.facebook.com -> your app -> Instagram
# Uses "Instagram API with Instagram Login" (graph.instagram.com).
# Professional (Business/Creator) accounts only.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback

# --- Worker ---
# How often the worker scans for due jobs, milliseconds.
WORKER_POLL_INTERVAL_MS=5000
WORKER_CONCURRENCY=2

# Seed user (pnpm db:seed). Change the password.
SEED_EMAIL=admin@postforge.local
SEED_PASSWORD=postforge-dev
